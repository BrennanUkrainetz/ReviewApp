# ---------------------------------------------------------------------------
# Supply-chain guard: a 30-day cooling-off window on every package version.
#
# Hijacked releases are typically spotted and unpublished within hours or days,
# so simply refusing to install anything published recently removes most of the
# exposure at effectively no cost — this project has no need for day-old
# dependencies.
#
# `before` makes npm resolve as if today were the date below, for direct and
# transitive dependencies alike. It is a fixed date rather than a rolling
# window because npm cannot compute one; `npm run deps:window` moves it
# forward to today minus 30 days.
#
# Letting it go stale is safe: the window only widens, so packages get older,
# never fresher.
#
# On npm >= 12 the same policy has a rolling form, `min-release-age=30`, which
# needs no refreshing. It is not used here because npm 12 requires Node
# >= 24.15 and this project currently runs on 24.14 — npm 11 ignores the
# setting with only a warning, which would be silent false security.
# ---------------------------------------------------------------------------
before=2026-06-21

# Exact versions in package.json, so a caret range can't drift into a fresh
# release on someone else's machine.
save-exact=true
